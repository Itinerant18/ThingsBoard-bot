# Caddy reverse proxy for ThingsBoard-Bot (audit #18).
# Replaces the `caddy reverse-proxy` quick command so SSE streaming, timeouts, and security
# headers are explicit. NOTE: replace the site address below with a real production domain;
# the nip.io address is a demo placeholder.

{
	# email for Let's Encrypt; certs persist in the caddy_data volume (docker-compose).
	email admin@seple.in
}

3.7.240.120.nip.io {
	encode gzip

	# Security headers (CSP frame-ancestors is set by the app itself).
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# SSE endpoint: disable proxy response buffering so chat tokens stream in real time
	# instead of arriving in one burst at the end.
	@sse path /api/v1/chat/ask/stream
	reverse_proxy @sse chatbot:8083 {
		flush_interval -1
		# Long-lived stream: don't cut the connection mid-generation.
		transport http {
			read_timeout 5m
			write_timeout 5m
		}
	}

	# Everything else.
	reverse_proxy chatbot:8083
}
