# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and auto-loaded for local/dev runs by DotenvEnvironmentPostProcessor.
# In production, set these as real environment variables instead (they override `.env`).

# --- TimescaleDB ---
TIMESCALE_URL=
TIMESCALE_USER=
TIMESCALE_PASSWORD=

# --- Redis ---
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=

# --- RabbitMQ ---
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=
RABBITMQ_SSL_ENABLED=

# --- ThingsBoard ---
TB_URL=
TB_USER=
TB_PASSWORD=
DEVICE_ID=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# --- Security (optional; guards enforce only when set) ---
IOTCHATBOT_SECURITY_WEBHOOK_HMAC_SECRET=
IOTCHATBOT_SECURITY_ADMIN_TOKEN=
IOTCHATBOT_SECURITY_ALLOWED_ORIGINS=

# --- JWT (optional; base64 HMAC key; enables signature verification when set) ---
IOTCHATBOT_JWT_SIGNING_KEY=
